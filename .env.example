# Copy this file to .env and fill in real values. .env is git-ignored and must never be committed.

# URL of the shared LiteLLM gateway on Render (Phase 4). Apps call this, never the Anthropic API directly.
LITELLM_PROXY_URL=https://your-render-service.onrender.com

# Voyage AI API key - free account at dash.voyageai.com (Phase 3)
VOYAGE_API_KEY=your-voyage-api-key

# Cosine similarity below which a clause is flagged for deviation analysis
DEVIATION_THRESHOLD=0.82

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
